load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_applicable_licenses = [],
    default_visibility = ["//visibility:public"],
)

# The configuration headers describe little-endian Linux LP64 with glibc.
config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(["lib/**/*.h"]) + [
        "version.h",
        ":crc32c_table",
    ],
    defines = [
        "HAVE_CONFIG_H",
        "_FILE_OFFSET_BITS=64",
    ],
    includes = [
        ".",
        "lib",
        "lib/et",
        "lib/ext2fs",
    ],
    target_compatible_with = select({
        ":linux_x86_64": [],
        ":linux_aarch64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_binary(
    name = "gen_crc32ctable",
    srcs = [
        "lib/ext2fs/crc32c_defs.h",
        "lib/ext2fs/gen_crc32ctable.c",
    ],
    visibility = ["//visibility:private"],
)

genrule(
    name = "crc32c_table",
    outs = ["lib/ext2fs/crc32c_table.h"],
    cmd = "$(location :gen_crc32ctable) > $@",
    tools = [":gen_crc32ctable"],
)

