# Upstream compiles this journal implementation with DEBUGFS, including when
# it is linked into tune2fs. e2fsck uses a different struct layout.
cc_library(
    name = "journal",
    srcs = [
        "debugfs/journal.c",
        "e2fsck/recovery.c",
        "e2fsck/revoke.c",
    ] + glob([
        "debugfs/*.h",
        "e2fsck/*.h",
        "misc/*.h",
    ]),
    copts = ["-std=gnu11"],
    includes = [
        "e2fsck",
        "misc",
    ],
    local_defines = ["DEBUGFS"],
    deps = [
        ":com_err",
        ":ext2fs",
    ],
)
